{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ariadne:recovery:snapshot:0.2",
  "title": "Ariadne normalized version graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope_id", "revision", "versions", "edges", "coverage"],
  "properties": {
    "schema_version": {"const": "ariadne.recovery/0.2"},
    "scope_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 0},
    "coverage": {"const": "complete_within_scope"},
    "missing_refs": {"type": "array", "maxItems": 0},
    "versions": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/version"}},
    "edges": {"type": "array", "maxItems": 320000, "items": {"$ref": "#/$defs/edge"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
    "version": {
      "type": "object", "additionalProperties": false,
      "required": ["version_id", "artifact_id", "content", "content_sha256", "origins"],
      "properties": {
        "version_id": {"$ref": "#/$defs/id"},
        "artifact_id": {"$ref": "#/$defs/id"},
        "content": {"type": "string", "maxLength": 100000},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "origins": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "parents": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "status": {"enum": ["active", "quarantined", "staged", "superseded"]},
        "writer_key": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "session_id": {"type": "string", "maxLength": 512}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["derived_from", "sanitized_from", "supersedes", "sequence", "supports"]}
      }
    }
  }
}
